# The schedule's OnCalendar= comes from a drop-in agent-admin writes
# (agent-schedule@<agent>_<schedule>.timer.d/schedule.conf).
[Unit]
Description=Schedule %i
Documentation=https://github.com/sdrahn/custos/blob/main/CONTRACT.md

[Timer]
Persistent=yes
RandomizedDelaySec=2min

[Install]
WantedBy=timers.target
