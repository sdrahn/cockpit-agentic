# Agent %i in an NVIDIA OpenShell sandbox: starts the sandbox and the port
# forward, and relays the agent's socket to it (CONTRACT.md §16a).
# agent-admin writes /etc/cockpit-agentic/agents/%i/openshell.env.
[Unit]
Description=Agent %i in OpenShell
Documentation=https://github.com/sdrahn/cockpit-agentic/blob/main/CONTRACT.md
Requires=agent-openshell@%i.socket
After=agent-openshell@%i.socket network-online.target mcp-gateway.service
Wants=network-online.target
ConditionPathExists=/etc/cockpit-agentic/agents/%i/openshell.env

[Service]
Type=exec
EnvironmentFile=/etc/cockpit-agentic/agents/%i/openshell.env
# Both may find the sandbox running and the forward set up already.
ExecStartPre=-/usr/bin/openshell -g ${OPENSHELL_GATEWAY} sandbox start agent-%i
ExecStartPre=-/usr/bin/openshell -g ${OPENSHELL_GATEWAY} forward start ${FORWARD_PORT} agent-%i -d
ExecStart=/usr/libexec/cockpit-agentic/agent-openshell-relay --name %i --upstream http://127.0.0.1:${FORWARD_PORT} --secret-file /etc/cockpit-agentic/agents/%i/relay.secret --logs "/usr/bin/openshell -g ${OPENSHELL_GATEWAY} logs agent-%i --tail"
ExecStopPost=-/usr/bin/openshell -g ${OPENSHELL_GATEWAY} forward stop ${FORWARD_PORT} agent-%i
ExecStopPost=-/usr/bin/openshell -g ${OPENSHELL_GATEWAY} sandbox stop agent-%i
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectHome=read-only
PrivateTmp=yes
