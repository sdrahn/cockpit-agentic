# The image an agent runs in under NVIDIA OpenShell (CONTRACT.md §16a):
# openSUSE Leap 16 with agent-launcher. Its configuration and the relay's
# secret come in the sandbox's environment (agent-admin), its state lives
# in the sandbox's working directory.
#
#   make build
#   podman build -t localhost/cockpit-agentic-agent:latest -f packaging/openshell/Containerfile \
#       --build-arg GATEWAY_CA="$(cat /etc/mcp-gateway/tls/ca.pem)" .
#
# GATEWAY_CA: the CA (PEM) of mcp-gateway's HTTPS certificate when no
# public root signs it. OpenShell's proxy terminates the agent's TLS to
# inspect MCP and swap in the token, and verifies the gateway with the
# image's trust store, so the CA goes there (not into the agent alone).
FROM registry.opensuse.org/opensuse/leap:16.0
# OpenShell runs the workload as the image's user "sandbox" (the sandbox
# policy's run_as_user), whose home is the working directory.
RUN zypper -n in --no-recommends ca-certificates shadow && \
    useradd -r -U -m -d /sandbox -s /usr/sbin/nologin sandbox && \
    zypper -n rm -u shadow && zypper -n clean -a
ARG GATEWAY_CA=
RUN if [ -n "$GATEWAY_CA" ]; then \
        printf '%s\n' "$GATEWAY_CA" >/etc/pki/trust/anchors/mcp-gateway.pem && update-ca-certificates; \
    fi
COPY bin/agent-launcher /usr/libexec/cockpit-agentic/agent-launcher
LABEL org.opencontainers.image.title="cockpit-agentic agent" \
      org.opencontainers.image.source="https://github.com/sdrahn/cockpit-agentic"
